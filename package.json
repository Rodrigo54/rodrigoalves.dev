  "scripts": {
    "ng": "ng",
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true ng serve",
    "dev:prod": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true ng serve --configuration production",
    "start": "bun run dev",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true ng build --configuration production",
    "build:develop": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true ng build --configuration development",
    "watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "bun ./scripts/postinstall.ts",
    "prepare": "husky"
  },
  "private": true,
