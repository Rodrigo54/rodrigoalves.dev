# Silences the staleness self-checks that browserslist and baseline-browser-mapping
# print on every run. Both packages warn whenever their bundled browser-usage data is
# more than ~2 months old, regardless of how current the package version itself is —
# this project targets only the latest browser versions (see .browserslistrc), so that
# staleness has no effect on what actually gets built.
BROWSERSLIST_IGNORE_OLD_DATA=1
BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=1
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
